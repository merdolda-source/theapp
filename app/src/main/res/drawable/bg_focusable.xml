<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_bg"/><corners android:radius="14dp"/>
        <stroke android:width="1.5dp" android:color="@color/focus_ring"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/gray_800"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/bg_card"/><corners android:radius="14dp"/>
        <stroke android:width="1dp" android:color="@color/gray_700"/></shape>
    </item>
</selector>
