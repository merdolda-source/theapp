<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/bg_dark"
        android:paddingLeft="16dp" android:paddingRight="12dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/tvTitleBar"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Canli TV"
            android:textColor="@color/white" android:textSize="20sp"
            android:textStyle="bold" android:focusable="true"/>
        <EditText android:id="@+id/etSearch"
            android:layout_width="180dp" android:layout_height="40dp"
            android:hint="Ara..." android:background="@drawable/selector_input_focus"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
            android:singleLine="true" android:imeOptions="actionSearch" android:textSize="13sp"
            android:focusable="true" android:focusableInTouchMode="true"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
        android:indeterminateTint="@color/primary_cyan"
        android:visibility="gone"/>

    <TextView android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/error_red" android:textSize="14sp"
        android:padding="8dp" android:visibility="gone"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvContent"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="8dp" android:clipToPadding="false" android:visibility="gone"/>

        <ScrollView android:id="@+id/layoutSettings"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_header_card"
                    android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tvDrawerUser"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Hesap: -" android:textColor="@color/white"
                        android:textStyle="bold" android:textSize="16sp"/>
                    <TextView android:id="@+id/tvDrawerExpire"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Sure: -" android:textColor="@color/text_secondary"
                        android:textSize="14sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Kayitli Hesaplar" android:textColor="@color/hint_yellow"
                    android:textStyle="bold" android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAccounts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/tvAddAccount"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:gravity="center" android:text="Yeni Hesap Ekle"
                    android:textColor="@color/white" android:textSize="14sp"
                    android:background="@drawable/bg_focusable" android:focusable="true"
                    android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvSettings"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:gravity="center" android:text="Oynatma Ayarlari"
                    android:textColor="@color/white" android:textSize="14sp"
                    android:background="@drawable/bg_focusable" android:focusable="true"
                    android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvLogout"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:gravity="center" android:text="Cikis Yap"
                    android:textColor="@color/error_red" android:textStyle="bold"
                    android:background="@drawable/bg_focusable" android:focusable="true"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <FrameLayout android:id="@+id/nativeAdContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:visibility="gone"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:background="@color/nav_bar_bg"
        android:elevation="8dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemTextAppearanceActive="@style/NavLabelActive"
        app:itemTextAppearanceInactive="@style/NavLabelInactive"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@color/gray_700"
        app:menu="@menu/bottom_nav_menu"/>
</LinearLayout>
