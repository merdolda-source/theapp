<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_splash">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="48dp">
        <ImageView android:id="@+id/ivSplashLogo"
            android:layout_width="96dp" android:layout_height="96dp"
            android:src="@mipmap/ic_launcher" android:layout_marginBottom="20dp"/>
        <TextView android:id="@+id/tvSplashName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Emin Xtream" android:textColor="@color/white"
            android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ultra IPTV Player" android:textColor="@color/hint_yellow"
            android:textSize="14sp" android:layout_marginBottom="56dp"/>
        <ProgressBar android:layout_width="40dp" android:layout_height="40dp"
            android:indeterminateTint="@color/primary_cyan"/>
    </LinearLayout>
    <TextView android:id="@+id/tvSplashVersion"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp"
        android:text="v3.1" android:textColor="@color/gray_600" android:textSize="11sp"/>
</FrameLayout>
