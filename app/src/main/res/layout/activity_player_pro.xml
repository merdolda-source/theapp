<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black">
    <androidx.media3.ui.PlayerView android:id="@+id/pvMain"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="true"/>
    <ProgressBar android:id="@+id/pbBuffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="72dp" android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary_cyan"
        android:visibility="gone"/>
    <LinearLayout android:id="@+id/overlayContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:layout_marginBottom="130dp">
        <View android:id="@+id/overlayLeft"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View android:id="@+id/overlayRight"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/layoutPlayerError"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
        android:padding="24dp" android:background="@color/player_overlay" android:visibility="gone">
        <TextView android:id="@+id/tvPlayerError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="15sp" android:gravity="center"
            android:layout_marginBottom="16dp"/>
        <Button android:id="@+id/btnPlayerRetry"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tekrar Dene" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:id="@+id/tvInfoCenter"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"
        android:background="@color/player_overlay" android:padding="14dp"
        android:layout_gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/tvSeekLeft"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"
        android:background="@color/player_overlay" android:padding="12dp"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="40dp"
        android:visibility="gone"/>
    <TextView android:id="@+id/tvSeekRight"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"
        android:background="@color/player_overlay" android:padding="12dp"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="40dp"
        android:visibility="gone"/>
    <TextView android:id="@+id/tvBrightness"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="13sp"
        android:background="@color/player_overlay" android:padding="8dp"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
        android:visibility="gone"/>
    <TextView android:id="@+id/tvVolume"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="13sp"
        android:background="@color/player_overlay" android:padding="8dp"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
        android:visibility="gone"/>
    <ImageButton android:id="@+id/btnLock"
        android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/bg_lock_btn"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:tint="@color/white"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp" android:layout_marginStart="16dp"
        android:focusable="true"/>
    <LinearLayout android:id="@+id/layoutLocked"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ekran Kilitli" android:textColor="@color/white"
            android:textSize="16sp" android:background="@color/player_overlay"
            android:padding="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kilitlemek icin sol ust kosedeki simgeye dokun"
            android:textColor="@color/hint_yellow" android:textSize="12sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/controlsOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/player_overlay">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="8dp" android:paddingRight="8dp">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@color/player_btn_bg"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/white" android:focusable="true"/>
            <TextView android:id="@+id/tvPlayerTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/white"
                android:textSize="14sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginLeft="8dp" android:layout_marginRight="8dp"/>
            <ImageButton android:id="@+id/btnAudioTrack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@color/player_btn_bg"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/white" android:layout_marginRight="6dp" android:focusable="true"/>
            <ImageButton android:id="@+id/btnSubtitle"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@color/player_btn_bg"
                android:src="@android:drawable/ic_menu_help"
                android:tint="@color/white" android:layout_marginRight="6dp" android:focusable="true"/>
            <ImageButton android:id="@+id/btnPip"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@color/player_btn_bg"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="@color/white" android:layout_marginRight="6dp" android:focusable="true"/>
            <ImageButton android:id="@+id/btnSleep"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@color/player_btn_bg"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="@color/white" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
            <LinearLayout android:id="@+id/btnSeekBack"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:padding="16dp" android:focusable="true" android:clickable="true">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_rew" android:tint="@color/white"/>
                <TextView android:id="@+id/tvSeekBackLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="10 sn" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <FrameLayout android:id="@+id/btnPlayPause"
                android:layout_width="80dp" android:layout_height="80dp"
                android:background="@color/player_btn_bg"
                android:layout_marginLeft="40dp" android:layout_marginRight="40dp"
                android:focusable="true" android:clickable="true">
                <ImageView android:id="@+id/ivPlayPauseIcon"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_media_pause" android:tint="@color/white"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/btnSeekFwd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:padding="16dp" android:focusable="true" android:clickable="true">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_ff" android:tint="@color/white"/>
                <TextView android:id="@+id/tvSeekFwdLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="10 sn" android:textColor="@color/white"
                    android:textSize="11sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <TextView android:id="@+id/tvPosition"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF" android:textSize="12sp"
                    android:fontFamily="monospace" android:visibility="gone"/>
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                <TextView android:id="@+id/tvSleepCountdown"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/primary_cyan" android:textSize="11sp"
                    android:background="@color/player_btn_bg" android:padding="4dp"
                    android:layout_marginRight="8dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvPlaybackSpeed"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1x" android:textColor="@color/primary_cyan" android:textSize="11sp"
                    android:background="@color/player_btn_bg" android:padding="4dp"
                    android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
                <TextView android:id="@+id/tvDuration"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#66FFFFFF" android:textSize="12sp"
                    android:fontFamily="monospace" android:visibility="gone"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seekBar"
                android:layout_width="match_parent" android:layout_height="28dp"
                android:progressTint="@color/primary_cyan" android:thumbTint="@color/primary_cyan"
                android:progressBackgroundTint="@color/seek_bg"
                android:layout_marginBottom="8dp" android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:id="@+id/liveBadge"
                    android:layout_width="wrap_content" android:layout_height="28dp"
                    android:background="#CCE74C3C" android:paddingLeft="12dp" android:paddingRight="12dp"
                    android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@color/white" android:layout_marginRight="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CANLI" android:textColor="@color/white"
                        android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/btnMode"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@color/player_btn_bg"
                    android:src="@android:drawable/ic_menu_crop"
                    android:tint="#AAFFFFFF" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/panelSpeed"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:background="@color/player_overlay" android:padding="20dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Oynatma Hizi" android:textColor="@color/hint_yellow"
            android:textSize="12sp" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/panelSpeed05"
                android:layout_width="64dp" android:layout_height="44dp"
                android:text="0.5x" android:gravity="center"
                android:textColor="@color/white" android:textSize="14sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/panelSpeed1"
                android:layout_width="64dp" android:layout_height="44dp"
                android:text="1x" android:gravity="center"
                android:textColor="@color/white" android:textSize="14sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/panelSpeed15"
                android:layout_width="64dp" android:layout_height="44dp"
                android:text="1.5x" android:gravity="center"
                android:textColor="@color/white" android:textSize="14sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/panelSpeed2"
                android:layout_width="64dp" android:layout_height="44dp"
                android:text="2x" android:gravity="center"
                android:textColor="@color/white" android:textSize="14sp"
                android:background="@drawable/bg_speed_btn"
                android:focusable="true" android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/panelSleep"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:background="@color/player_overlay" android:padding="20dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Uyku Zamanlayicisi" android:textColor="@color/hint_yellow"
            android:textSize="12sp" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/sleepOff"
                android:layout_width="56dp" android:layout_height="44dp"
                android:text="Kapat" android:gravity="center"
                android:textColor="@color/white" android:textSize="12sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/sleep15"
                android:layout_width="56dp" android:layout_height="44dp"
                android:text="15dk" android:gravity="center"
                android:textColor="@color/white" android:textSize="13sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/sleep30"
                android:layout_width="56dp" android:layout_height="44dp"
                android:text="30dk" android:gravity="center"
                android:textColor="@color/white" android:textSize="13sp"
                android:background="@drawable/bg_speed_btn"
                android:layout_marginRight="8dp" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/sleep60"
                android:layout_width="56dp" android:layout_height="44dp"
                android:text="60dk" android:gravity="center"
                android:textColor="@color/white" android:textSize="13sp"
                android:background="@drawable/bg_speed_btn"
                android:focusable="true" android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
