<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="24dp" android:paddingRight="24dp"
        android:paddingTop="16dp" android:paddingBottom="32dp">
        <FrameLayout android:id="@+id/nativeAdContainerLogin"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="28dp">
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:src="@mipmap/ic_launcher" android:layout_marginRight="12dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Emin Xtream" android:textColor="@color/white"
                    android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hesap ekle veya sec" android:textColor="@color/hint_yellow"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
            android:orientation="horizontal" android:background="@drawable/bg_input_dark"
            android:padding="3dp" android:layout_marginBottom="20dp">
            <LinearLayout android:id="@+id/cardXtream"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:background="@drawable/bg_header_card"
                android:focusable="true" android:clickable="true">
                <TextView android:id="@+id/tvXtream"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Xtream Codes" android:textColor="@color/white"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardM3u"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:background="@android:color/transparent"
                android:focusable="true" android:clickable="true">
                <TextView android:id="@+id/tvM3u"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="M3U Liste" android:textColor="@color/hint_yellow"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <EditText android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Hesap Adi" android:background="@drawable/selector_input_focus"
            android:paddingLeft="16dp" android:paddingRight="16dp"
            android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
            android:textSize="14sp" android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>
        <LinearLayout android:id="@+id/layoutXtream"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <EditText android:id="@+id/etDns"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="http://sunucu.com:8080" android:background="@drawable/selector_input_focus"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
                android:textSize="13sp" android:inputType="textUri" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/etUser"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Kullanici adi" android:background="@drawable/selector_input_focus"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
                android:textSize="14sp" android:inputType="textNoSuggestions"
                android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etPass"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Sifre" android:background="@drawable/selector_input_focus"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
                android:textSize="14sp" android:inputType="textVisiblePassword"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutM3u"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <EditText android:id="@+id/etM3u"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="http://.../playlist.m3u"
                android:background="@drawable/selector_input_focus"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:textColor="@color/white" android:textColorHint="@color/hint_yellow"
                android:textSize="13sp" android:inputType="textUri"/>
        </LinearLayout>
        <Button android:id="@+id/btnAddAccount"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Hesap Ekle" android:textStyle="bold"
            android:textColor="@color/black" android:textSize="15sp"
            android:background="@color/primary_cyan"
            android:layout_marginTop="16dp" android:layout_marginBottom="28dp"
            android:focusable="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Kayitli Hesaplar" android:textColor="@color/white"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <ListView android:id="@+id/lvAccounts"
            android:layout_width="match_parent" android:layout_height="320dp"
            android:divider="@android:color/transparent" android:dividerHeight="8dp"/>
    </LinearLayout>
</ScrollView>
